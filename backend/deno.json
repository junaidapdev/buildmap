{
  "imports": {
    "@shared/": "./_shared/",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.106.2",
    "zod": "npm:zod@4.4.3",
    "jszip": "npm:jszip@3.10.1"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": true
  },
  "tasks": {
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check functions/**/*.ts _shared/**/*.ts"
  }
}
